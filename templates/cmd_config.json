{
  "config_version": 5,
  "platform_settings": {
    "unique_session": false,
    "rate_limit": {
      "time": 60,
      "count": 30,
      "strategy": "stall"
    },
    "reply_prefix": "",
    "forward_threshold": 1500,
    "enable_id_white_list": true,
    "id_whitelist": [],
    "id_whitelist_log": true,
    "wl_ignore_admin_on_group": true,
    "wl_ignore_admin_on_friend": true,
    "reply_with_mention": false,
    "reply_with_quote": false,
    "path_mapping": [],
    "segmented_reply": {
      "enable": true,
      "only_llm_result": true,
      "interval_method": "random",
      "interval": "1.5,3.5",
      "log_base": 2.6,
      "words_count_threshold": 150,
      "split_mode": "regex",
      "regex": "[^\\n]+",
      "split_words": [
        "。",
        "？",
        "！",
        "~",
        "…"
      ],
      "content_cleanup_rule": ""
    },
    "no_permission_reply": true,
    "empty_mention_waiting": false,
    "empty_mention_waiting_need_reply": true,
    "friend_message_needs_wake_prefix": false,
    "ignore_bot_self_message": false,
    "ignore_at_all": false
  },
  "provider_sources": [
    {
      "provider": "deepseek",
      "type": "openai_chat_completion",
      "provider_type": "chat_completion",
      "key": [
        "<API_KEY>"
      ],
      "api_base": "https://api.deepseek.com",
      "timeout": 120,
      "proxy": "",
      "custom_headers": {},
      "id": "deepseek",
      "enable": true
    }
  ],
  "provider": [
    {
      "id": "deepseek/deepseek-flash",
      "enable": true,
      "provider_source_id": "deepseek",
      "model": "deepseek-flash",
      "modalities": [
        "text",
        "tool_use"
      ],
      "custom_extra_body": {
        "thinking": {
          "type": "disabled"
        }
      },
      "max_context_tokens": 1000000
    },
    {
      "id": "deepseek/deepseek-vision",
      "enable": true,
      "provider_source_id": "deepseek",
      "model": "deepseek-flash",
      "modalities": [
        "text",
        "image",
        "tool_use"
      ],
      "custom_extra_body": {
        "thinking": {
          "type": "disabled"
        }
      },
      "max_context_tokens": 1000000
    },
    {
      "id": "sensevoice-local",
      "provider": "sensevoice",
      "type": "sensevoice_stt_selfhost",
      "provider_type": "speech_to_text",
      "enable": true,
      "stt_model": "<INSTALL_ROOT>/runtime/models/SenseVoiceSmall-onnx",
      "is_emotion": false
    },
    {
      "id": "whale-local-embedding",
      "type": "whale_local_embedding",
      "provider_type": "embedding",
      "enable": true,
      "model_dir": "<INSTALL_ROOT>/runtime/models/bge-small-zh-v1.5",
      "model": "bge-small-zh-v1.5"
    }
  ],
  "provider_settings": {
    "enable": true,
    "default_image_caption_provider_id": "deepseek/deepseek-vision",
    "image_caption_prompt": "Please describe the image using Chinese.",
    "provider_pool": [
      "*"
    ],
    "wake_prefix": "",
    "web_search": true,
    "websearch_provider": "deepseek",
    "websearch_tavily_key": [],
    "websearch_bocha_key": [],
    "websearch_brave_key": [],
    "websearch_baidu_app_builder_key": "",
    "websearch_firecrawl_key": [],
    "websearch_exa_key": [],
    "websearch_anysearch_key": [],
    "websearch_deepseek_key": "<API_KEY>",
    "websearch_serpapi_key": [],
    "web_search_link": false,
    "display_reasoning_text": false,
    "identifier": true,
    "group_name_display": true,
    "datetime_system_prompt": true,
    "persona_pool": [
      "*"
    ],
    "prompt_prefix": "{{prompt}}",
    "streaming_response": false,
    "show_tool_use_status": false,
    "show_tool_call_result": false,
    "buffer_intermediate_messages": false,
    "max_quoted_fallback_images": 20,
