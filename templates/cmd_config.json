      "cua_idle_timeout": 0,
      "cua_telemetry_enabled": false,
      "cua_local": true,
      "cua_api_key": ""
    },
    "image_compress_options": {
      "max_size": 1280
    }
  },
  "agent_runner": {
    "runner_type": "local",
    "config": {
      "model": {
        "provider_id": "deepseek/deepseek-flash",
        "fallback_provider_ids": [],
